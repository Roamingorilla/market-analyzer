# ─────────────────────────────────────────────────
# Market Analyser — Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ─────────────────────────────────────────────────

# ── Marketstack ──────────────────────────────────
MARKETSTACK_API_KEY=your_marketstack_api_key_here
MARKETSTACK_MONTHLY_LIMIT=10000
MARKETSTACK_SAFE_USAGE_PCT=0.85

# ── Alpha Vantage (Fundamentals) ─────────────────
# Free tier: 25 requests/day — cached 30 days
ALPHAVANTAGE_API_KEY=your_alpha_vantage_key_here

# ── Gemini AI (Phase 3) ──────────────────────────
# Leave empty until Phase 3
GEMINI_API_KEY=

# ── Database ─────────────────────────────────────
POSTGRES_USER=marketanalyser
POSTGRES_PASSWORD=change_this_password_in_production

# ── Redis ────────────────────────────────────────
REDIS_PASSWORD=

# ── RabbitMQ ─────────────────────────────────────
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ── Security ─────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change_this_to_a_secure_256_bit_secret_in_production

# ── Frontend ─────────────────────────────────────
# Set to your server's IP or domain for production
NEXT_PUBLIC_API_URL=http://localhost/api
